POSTGRES_DB=omni
POSTGRES_USER=omni
POSTGRES_PASSWORD=omni_dev
POSTGRES_PORT=5432

# AC-04: role de RUNTIME da api (least-privilege, sem DDL). O migrate continua
# usando POSTGRES_USER. Senha alfanumerica (evita urlencode na DATABASE_APP_URL).
APP_DB_ROLE=omni_app
APP_DB_ROLE_PASSWORD=omni_app_dev

API_PORT=8080
WEB_PORT=3003

# Se API_PORT mudar, atualize esta URL para a mesma porta publica.
NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_API_INTERNAL_BASE=http://api:8080

# Bio (link-in-bio) — front publico crow-nuxt. SO PARA O DEV LOCAL (preview do
# editor): roda como servico docker (build de producao), sobe junto do compose e
# reinicia sozinho. Serve as bios publicadas E o /bio/preview do iframe do editor.
# DEPLOY/VPS: NAO subir o crow-nuxt deste compose — o front bio tera container
# proprio (a definir); na VPS apontar NUXT_PUBLIC_BIO_FRONT_URL pro dominio real.
# Host 3300 (porta NAO-PADRAO) deve bater com NUXT_PUBLIC_BIO_FRONT_URL.
NUXT_PUBLIC_BIO_FRONT_URL=http://localhost:3300
CROW_NUXT_PORT=3300
# crow-nuxt -> api do painel pela rede interna do compose (SSR/server-side).
CROW_NUXT_API_BASE=http://api:8080/v1/public
# browser-side (SSE da bio publica): host-mapeado na porta publica da api.
NUXT_PUBLIC_STREAM_BASE=http://localhost:9091/v1/public

DATABASE_MIN_CONNS=0
DATABASE_MAX_CONNS=10
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

AUTH_TOKEN_SECRET=troque-por-um-segredo-longo-e-aleatorio
AUTH_TOKEN_TTL=12h
# Cache de Principal autenticado (AC-01). 0s desliga. Default 30s.
# AUTH_PRINCIPAL_CACHE_TTL=30s
AUTH_BCRYPT_COST=10
AUTH_CONSULTANT_EMAIL_DOMAIN=acesso.omni.local
AUTH_CONSULTANT_DEFAULT_PASSWORD=troque-esta-senha-local

ERP_BOOTSTRAP_ITEM_FILE=consolidados/184/item_184_consolidado.md
ERP_BOOTSTRAP_CUSTOMER_FILE=consolidados/184/customer_184_consolidado.md
ERP_BOOTSTRAP_EMPLOYEE_FILE=consolidados/184/employee_184_consolidado.md
ERP_BOOTSTRAP_ORDER_FILE=consolidados/184/order_184_consolidado.md
ERP_BOOTSTRAP_ORDER_CANCELED_FILE=consolidados/184/ordercanceled_184_consolidado.md
ERP_ALLOW_MANUAL_SYNC=true
ERP_CSV_MAX_BYTES=134217728
ERP_MANUAL_SYNC_MAX_FILES=100
ERP_BACKFILL_MAX_FILES=1000
ERP_MANUAL_SYNC_MIN_INTERVAL=5m

# Modulo automation (n8n + WAHA + Redis) — profile "automation".
# Portas no host; defaults escolhidos para nao colidir com o Omni (api/web/postgres).
# Sobe com: docker compose --profile automation up -d
AUTOMATION_N8N_PORT=5680
AUTOMATION_WAHA_PORT=3010
AUTOMATION_REDIS_PORT=6380
# Senha do Redis do bot. Precisa bater com a credencial "Redis account" importada no n8n.
AUTOMATION_REDIS_PASSWORD=default
# Token de servico que o n8n usa pra ler o runtime-config da API (M2: persona/enabled
# do banco) e que a api usa no Bearer Go->n8n do Omni Chat (M0). api e n8n compartilham
# o mesmo valor. Default dev ja bate nos 2 servicos.
AUTOMATION_RUNTIME_TOKEN=dev-automation-runtime-token
# Omni Chat (M0): base interna do n8n p/ o webhook POST /webhook/omni-chat (proxy
# Go->n8n do chat do painel de Operacao). Default ja aponta pro servico n8n do compose.
AUTOMATION_N8N_INTERNAL_URL=http://n8n:5678
# Sessao fisica da WAHA no Conectar/Status/Logout/QR. A WAHA Core so aceita "default"
# (1 numero por instancia, compartilhado entre contas). "@channel" = 1 sessao por conta
# (so com WAHA Plus). Default "default".
AUTOMATION_WAHA_SESSION=default

# Modulo calendar (agenda de conteudo) — IA por n8n. Plano do mes (Fase 6): webhook
# do n8n + token de servico do callback + base da api que o n8n chama de volta.
# So funcionam com o profile automation no ar (workflows importados/ativos). Vazios
# => POST /v1/calendar/ai/plan responde 503 ai_not_configured.
CALENDAR_AI_WEBHOOK_URL=http://n8n:5678/webhook/calendar-omni
CALENDAR_AI_SERVICE_TOKEN=dev-calendar-ai-token
CALENDAR_AI_CALLBACK_BASE=http://api:8080
# Chat flutuante + voz (C7/C8): webhooks do n8n. Vazios => /v1/calendar/chat/ask e
# /chat/transcribe respondem 503 acionavel (chat_not_configured/transcribe_not_configured).
CALENDAR_CHAT_WEBHOOK_URL=http://n8n:5678/webhook/calendar-chat
CALENDAR_TRANSCRIBE_WEBHOOK_URL=http://n8n:5678/webhook/calendar-transcribe

# Modulo meta_ads (Meta/Facebook Ads). Sem container proprio (api fala HTTPS direto).
# Base da Graph/Marketing API (opcional; ja tem default no codigo).
META_ADS_GRAPH_BASE=https://graph.facebook.com/v21.0
# Chave simetrica (pgcrypto) p/ cifrar o System User token at-rest. OBRIGATORIA para
# conectar (sem ela, POST /v1/meta-ads/connection retorna 503). Gerar valor forte;
# NAO commitar o .env real.
META_ADS_CRYPTO_KEY=

# Modulo meta_ads assistant (agent-runner MA1). Modo padrao local: rodar no HOST
# (npm start em meta-ads-assistant/); o container (profile meta-ads-assistant) e
# p/ VPS/futuro e exige CLAUDE_CODE_OAUTH_TOKEN (gerado via `claude setup-token`).
META_ADS_ASSISTANT_PORT=8765
# Token de servico do POST /run. api e runner compartilham o mesmo valor.
META_ADS_ASSISTANT_TOKEN=dev-meta-assistant-token
# URL que o api (container) usa p/ falar com o runner; default = runner no host.
META_ADS_ASSISTANT_RUNNER_URL=http://host.docker.internal:8765
# Timeout por execucao do agente (ms); estourou -> 504 assistant_timeout.
META_ADS_ASSISTANT_TIMEOUT_MS=120000
# Bearer de servico do bridge interno (/internal/meta-ads/runner/*) que o runner
# usa p/ buscar postagens do Instagram via api Go. Vazio = bridge desligado (503).
# O MESMO valor precisa estar no ambiente do runner (host) E do api (container).
META_ADS_RUNNER_BRIDGE_TOKEN=dev-meta-bridge-token
# Envs do RUNNER (processo no host; defaults no codigo, listadas aqui p/ referencia):
#   META_ADS_API_BASE=http://localhost:9091   (onde o runner acha o api Go/bridge)
#   META_ADS_OAUTH_CALLBACK_PORT=8766         (callback do OAuth persistente da Meta;
#     o token fica em meta-ads-assistant/.auth/ — fora do git, preservar na VPS)
