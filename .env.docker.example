POSTGRES_DB=omni
POSTGRES_USER=omni
POSTGRES_PASSWORD=omni_dev
POSTGRES_PORT=5432

API_PORT=8080
WEB_PORT=3003

# Se API_PORT mudar, atualize esta URL para a mesma porta publica.
NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_API_INTERNAL_BASE=http://api:8080

DATABASE_MIN_CONNS=0
DATABASE_MAX_CONNS=10
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

AUTH_TOKEN_SECRET=troque-por-um-segredo-longo-e-aleatorio
AUTH_TOKEN_TTL=12h
# U4c: tabelas user_*_roles legadas foram dropadas (migration 0135). Use SEMPRE
# `core`; `legacy`/`core_with_fallback` consultam tabelas inexistentes e quebram o login.
AUTH_ROLES_SOURCE=core
AUTH_BCRYPT_COST=10
AUTH_CONSULTANT_EMAIL_DOMAIN=acesso.omni.local
AUTH_CONSULTANT_DEFAULT_PASSWORD=troque-esta-senha-local

ERP_BOOTSTRAP_ITEM_FILE=consolidados/184/item_184_consolidado.md
ERP_BOOTSTRAP_CUSTOMER_FILE=consolidados/184/customer_184_consolidado.md
ERP_BOOTSTRAP_EMPLOYEE_FILE=consolidados/184/employee_184_consolidado.md
ERP_BOOTSTRAP_ORDER_FILE=consolidados/184/order_184_consolidado.md
ERP_BOOTSTRAP_ORDER_CANCELED_FILE=consolidados/184/ordercanceled_184_consolidado.md
ERP_ALLOW_MANUAL_SYNC=true
ERP_CSV_MAX_BYTES=134217728
ERP_MANUAL_SYNC_MAX_FILES=100
ERP_BACKFILL_MAX_FILES=1000
ERP_MANUAL_SYNC_MIN_INTERVAL=5m

# Modulo automation (n8n + WAHA + Redis) — profile "automation".
# Portas no host; defaults escolhidos para nao colidir com o Omni (api/web/postgres).
# Sobe com: docker compose --profile automation up -d
AUTOMATION_N8N_PORT=5680
AUTOMATION_WAHA_PORT=3010
AUTOMATION_REDIS_PORT=6380
# Senha do Redis do bot. Precisa bater com a credencial "Redis account" importada no n8n.
AUTOMATION_REDIS_PASSWORD=default
# Token de servico que o n8n usa pra ler o runtime-config da API (M2: persona/enabled
# do banco). api e n8n compartilham o mesmo valor. Default dev ja bate nos 2 servicos.
AUTOMATION_RUNTIME_TOKEN=dev-automation-runtime-token
