COMPOSE_PROJECT_NAME=omni

# ── Imagens do registry (GHCR) ──
# Build sai da VPS: o GitHub Actions builda e publica em ghcr.io; a VPS so faz
# `pull` + `up --no-build`. API_IMAGE/WEB_IMAGE sao o repositorio da imagem;
# IMAGE_TAG recebe o SHA do git do build promovido (NAO "latest") — e o que
# garante "o que testei em staging e o que subiu em prod".
API_IMAGE=ghcr.io/mikewade2k16/omni-api
WEB_IMAGE=ghcr.io/mikewade2k16/omni-web
IMAGE_TAG=latest

APP_NAME=omni-api

# Pos-0135: Core V2 + roles em core sao o unico caminho valido.
CORE_V2_ENABLED=true

POSTGRES_DB=omni
POSTGRES_USER=omni
POSTGRES_PASSWORD=troque-essa-senha-forte

API_PORT=18080
WEB_PORT=13003
PROXY_NETWORK_NAME=omnichannel-mvp_default
PROXY_API_ALIAS=lista-api
PROXY_WEB_ALIAS=lista-web

WEB_APP_URL=https://omni.crowvisuals.com.br
NUXT_PUBLIC_API_BASE=https://omni.crowvisuals.com.br
NUXT_PUBLIC_API_WS_BASE=wss://omni.crowvisuals.com.br
CORS_ALLOWED_ORIGINS=https://omni.crowvisuals.com.br


NUXT_API_INTERNAL_BASE=http://api:8080



DATABASE_MIN_CONNS=0
DATABASE_MAX_CONNS=10

AUTH_TOKEN_SECRET=troque-por-um-segredo-longo-e-aleatorio
AUTH_TOKEN_TTL=12h
AUTH_INVITE_TTL=168h
AUTH_PASSWORD_RESET_TTL=30m
AUTH_BCRYPT_COST=10
# Gate SSO do n8n/waha pelo login do Omni (Caddy forward_auth -> /v1/auth/gateway/verify).
# Dominio do cookie de sessao: precisa ser o pai comum de omni./n8n./waha. para o cookie
# valer nos tres subdominios. Ver docs/automation/SSO_GATEWAY_PLAN.md.
AUTH_GATEWAY_COOKIE_DOMAIN=.crowvisuals.com.br

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Omni
SMTP_TLS_MODE=starttls
SMTP_INSECURE_SKIP_VERIFY=false
SMTP_TIMEOUT=10s

AUTH_CONSULTANT_EMAIL_DOMAIN=whenthelightsdie.com
AUTH_CONSULTANT_DEFAULT_PASSWORD=troque-essa-senha-inicial

ERP_SOURCE_HOST_DIR=./erp-source
ERP_SOURCE_DIR=/app/data/erp/source
ERP_STORAGE_DIR=/app/data/erp/storage
ERP_BOOTSTRAP_ITEM_FILE=consolidados/184/item_184_consolidado.md
ERP_BOOTSTRAP_CUSTOMER_FILE=consolidados/184/customer_184_consolidado.md
ERP_BOOTSTRAP_EMPLOYEE_FILE=consolidados/184/employee_184_consolidado.md
ERP_BOOTSTRAP_ORDER_FILE=consolidados/184/order_184_consolidado.md
ERP_BOOTSTRAP_ORDER_CANCELED_FILE=consolidados/184/ordercanceled_184_consolidado.md
ERP_BOOTSTRAP_TENANT_ID=
ERP_BOOTSTRAP_TENANT_SLUG=whenthelightsdie
ERP_BOOTSTRAP_STORE_CODE=184
ERP_BOOTSTRAP_STORE_NAME=Loja 184
ERP_BOOTSTRAP_STORE_CITY=
ERP_SOURCE_KIND=ftp
ERP_SOURCE_RECURSIVE=false
ERP_FTP_HOST=
ERP_FTP_PORT=21
ERP_FTP_USER=
ERP_FTP_PASSWORD=
ERP_FTP_KEY_PATH=
ERP_FTP_REMOTE_DIR=
ERP_FTP_HOST_KEY=
ERP_ROOT_STORE_CODE=184
ERP_ALLOW_MANUAL_SYNC=true
ERP_SYNC_INTERVAL=24h
ERP_SYNC_HOUR_UTC=4
ERP_SYNC_AUTOMATIC_ENABLED=true
ERP_SYNC_DRY_RUN_DEFAULT=false
ERP_CSV_MAX_BYTES=134217728
ERP_MANUAL_SYNC_MAX_FILES=100
ERP_BACKFILL_MAX_FILES=1000
ERP_MANUAL_SYNC_MIN_INTERVAL=5m

# ── Modulo automation (n8n + WAHA + Redis) — profile "automation" ──
# Sobe so com:  docker compose -f docker-compose.prod.yml --profile automation up -d
# Caddy roteia n8n/waha por subdominio (basic auth no edge). Webhook WAHA->n8n e' interno.
# Redis fica so na rede "app" (nunca publico) e ja disponivel para a API do Omni usar depois.
# Runbook completo: docs/automation/SETUP.md secao 8.
AUTOMATION_N8N_HOST=n8n.crowvisuals.com.br
AUTOMATION_N8N_WEBHOOK_URL=https://n8n.crowvisuals.com.br
AUTOMATION_N8N_PROXY_ALIAS=automation-n8n
# Chave de criptografia do n8n (protege as credenciais no volume). Gere uma vez e NAO
# mude depois (senao as credenciais salvas param de decriptar). Ex.: openssl rand -hex 24
AUTOMATION_N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-longa
AUTOMATION_WAHA_HOST=waha.crowvisuals.com.br
AUTOMATION_WAHA_PROXY_ALIAS=automation-waha
# Auth do dashboard da WAHA (defesa em profundidade, alem do basic auth do Caddy).
AUTOMATION_WAHA_DASHBOARD_USER=admin
AUTOMATION_WAHA_DASHBOARD_PASSWORD=troque-essa-senha-forte
# Senha do Redis do bot (precisa bater com a credencial "Redis account" importada no n8n).
AUTOMATION_REDIS_PASSWORD=troque-essa-senha-forte
# Token de servico do runtime-config (M2) e do Bearer Go->n8n do Omni Chat (M0).
# api e n8n usam o MESMO valor. Gere forte: openssl rand -hex 24
AUTOMATION_RUNTIME_TOKEN=troque-por-um-token-forte
# Omni Chat (M0): base interna do n8n p/ o webhook POST /webhook/omni-chat. Na rede
# do compose o servico se chama "n8n"; manter o default a menos que renomeie.
AUTOMATION_N8N_INTERNAL_URL=http://n8n:5678
# Sessao fisica da WAHA no Conectar/Status/Logout/QR. WAHA Core so aceita "default"
# (1 numero, compartilhado entre contas). "@channel" = 1 sessao por conta (so WAHA Plus).
AUTOMATION_WAHA_SESSION=default
# Binds locais (127.0.0.1) so para tunel SSH/debug — NAO sao publicos.
AUTOMATION_N8N_PORT=15680
AUTOMATION_WAHA_PORT=13010
AUTOMATION_REDIS_PORT=16380
