# ============================================================================
# .env.staging.example — ambiente de STAGING do Omni (mesma VPS, sob demanda)
# ----------------------------------------------------------------------------
# Usa o MESMO docker-compose.prod.yml de prod; o que muda e' so o --env-file
# e o COMPOSE_PROJECT_NAME. Project name diferente ja' namespaceia containers,
# volumes (omni-staging_postgres_data, etc.) e rede automaticamente — staging
# NAO compartilha dado nem volume com prod.
#
# Subir/derrubar (ver docs/deploy/STAGING_SETUP.md):
#   docker compose --env-file .env.staging -f docker-compose.prod.yml up -d
#   docker compose --env-file .env.staging -f docker-compose.prod.yml down
#
# SEED DO BANCO DE STAGING: o volume omni-staging_postgres_data comeca vazio e
# a api roda `migrate up` no boot (staging vira ensaio real das migrations).
# Recomendado: bootstrap de um owner de TESTE limpo (sem PII real de cliente).
# Opcao alternativa: restaurar um backup SANITIZADO da prod (mascarar/baralhar
# e-mails, telefones, senhas) — nunca o dump bruto de producao.
#
# SEGREDOS: todos os *_PASSWORD / *_SECRET / *_KEY abaixo sao PROPRIOS do staging.
# NUNCA reutilize os segredos de prod aqui.
# ============================================================================

# Namespace proprio (containers/volumes/rede separados de prod).
COMPOSE_PROJECT_NAME=omni-staging

# ── Imagens do registry (GHCR) ──
# Mesmos repositorios da prod: staging e prod promovem o MESMO artefato.
# IMAGE_TAG recebe o SHA candidato a promocao (preencher antes de subir;
# NAO usar "latest" — o objetivo do staging e' testar um SHA especifico).
API_IMAGE=ghcr.io/mikewade2k16/omni-api
WEB_IMAGE=ghcr.io/mikewade2k16/omni-web
IMAGE_TAG=

APP_NAME=omni-api-staging

# Pos-0135: Core V2 + roles em core sao o unico caminho valido.
CORE_V2_ENABLED=true

# ── Banco (volume omni-staging_postgres_data, isolado de prod) ──
# Segredos proprios do staging, NUNCA os de prod.
POSTGRES_DB=omni
POSTGRES_USER=omni
POSTGRES_PASSWORD=TROQUE-senha-forte-EXCLUSIVA-do-staging

# AC-04: role de RUNTIME da api (least-privilege, sem DDL). Segredo PROPRIO do
# staging, NUNCA o de prod. Senha alfanumerica (evita urlencode na DATABASE_APP_URL).
# Criar a role antes de subir a api (runbook AC-04, item Staging).
APP_DB_ROLE=omni_app
APP_DB_ROLE_PASSWORD=TROQUE-senha-forte-alfanumerica-EXCLUSIVA-do-staging

# ── Portas de host (binds 127.0.0.1) ──
# DISTINTAS das de prod E de outras stacks da VPS para nao colidir.
# IMPORTANTE: confira o que ja esta em uso antes de escolher:
#   docker ps --format '{{.Names}} {{.Ports}}' | grep -oE '127.0.0.1:[0-9]+' | sort -u
# Na VPS auditada (2026-06-16) ja estavam em uso: 13003, 13004, 14080, 18080, 18081
# (prod omni = 18080/13003; stack omni-crow = 18081/13004). Por isso o preview usa 18082/13005.
API_PORT=18082
WEB_PORT=13005

# Rede externa do Caddy (mesma da prod — o roteamento por host separa staging de prod).
PROXY_NETWORK_NAME=omnichannel-mvp_default
# Aliases proprios para o Caddy rotear preview.whenthelightsdie.com.
PROXY_API_ALIAS=lista-staging-api
PROXY_WEB_ALIAS=lista-staging-web

# ── URLs / CORS do staging ──
WEB_APP_URL=https://preview.whenthelightsdie.com
NUXT_PUBLIC_API_BASE=https://preview.whenthelightsdie.com
NUXT_PUBLIC_API_WS_BASE=wss://preview.whenthelightsdie.com
CORS_ALLOWED_ORIGINS=https://preview.whenthelightsdie.com


NUXT_API_INTERNAL_BASE=http://api:8080



DATABASE_MIN_CONNS=0
DATABASE_MAX_CONNS=10

# Segredo proprio do staging, NUNCA o de prod.
AUTH_TOKEN_SECRET=TROQUE-por-um-segredo-longo-e-aleatorio-EXCLUSIVO-do-staging
AUTH_TOKEN_TTL=12h
AUTH_INVITE_TTL=168h
AUTH_PASSWORD_RESET_TTL=30m
# Cache de Principal autenticado (AC-01). 0s desliga. Default 30s.
# AUTH_PRINCIPAL_CACHE_TTL=30s
AUTH_BCRYPT_COST=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Omni (staging)
SMTP_TLS_MODE=starttls
SMTP_INSECURE_SKIP_VERIFY=false
SMTP_TIMEOUT=10s

AUTH_CONSULTANT_EMAIL_DOMAIN=whenthelightsdie.com
# Segredo proprio do staging, NUNCA o de prod.
AUTH_CONSULTANT_DEFAULT_PASSWORD=TROQUE-senha-inicial-EXCLUSIVA-do-staging

ERP_SOURCE_HOST_DIR=./erp-source
ERP_SOURCE_DIR=/app/data/erp/source
ERP_STORAGE_DIR=/app/data/erp/storage
ERP_BOOTSTRAP_ITEM_FILE=consolidados/184/item_184_consolidado.md
ERP_BOOTSTRAP_CUSTOMER_FILE=consolidados/184/customer_184_consolidado.md
ERP_BOOTSTRAP_EMPLOYEE_FILE=consolidados/184/employee_184_consolidado.md
ERP_BOOTSTRAP_ORDER_FILE=consolidados/184/order_184_consolidado.md
ERP_BOOTSTRAP_ORDER_CANCELED_FILE=consolidados/184/ordercanceled_184_consolidado.md
ERP_BOOTSTRAP_TENANT_ID=
ERP_BOOTSTRAP_TENANT_SLUG=whenthelightsdie
ERP_BOOTSTRAP_STORE_CODE=184
ERP_BOOTSTRAP_STORE_NAME=Loja 184
ERP_BOOTSTRAP_STORE_CITY=
# Em staging, sincronizacao ERP local por padrao (sem credencial FTP real de prod).
ERP_SOURCE_KIND=local
ERP_SOURCE_RECURSIVE=false
ERP_FTP_HOST=
ERP_FTP_PORT=21
ERP_FTP_USER=
ERP_FTP_PASSWORD=
ERP_FTP_KEY_PATH=
ERP_FTP_REMOTE_DIR=
ERP_FTP_HOST_KEY=
ERP_ROOT_STORE_CODE=184
ERP_ALLOW_MANUAL_SYNC=true
ERP_SYNC_INTERVAL=24h
ERP_SYNC_HOUR_UTC=4
# Sync automatico desligado em staging (liga sob demanda se precisar testar).
ERP_SYNC_AUTOMATIC_ENABLED=false
ERP_SYNC_DRY_RUN_DEFAULT=false
ERP_CSV_MAX_BYTES=134217728
ERP_MANUAL_SYNC_MAX_FILES=100
ERP_BACKFILL_MAX_FILES=1000
ERP_MANUAL_SYNC_MIN_INTERVAL=5m

# ── Modulo automation (n8n + WAHA + Redis) — profile "automation" ──
# DESLIGADO por padrao em staging (economia de RAM na VPS compartilhada com prod).
# Sobe sob demanda APENAS se precisar testar o bot, e com segredos proprios:
#   docker compose --env-file .env.staging -f docker-compose.prod.yml --profile automation up -d
# Caddy roteia n8n/waha por subdominio (basic auth no edge). Webhook WAHA->n8n e' interno.
# Os valores abaixo so sao usados se o profile "automation" for ligado.
AUTOMATION_N8N_HOST=n8n-preview.whenthelightsdie.com
AUTOMATION_N8N_WEBHOOK_URL=https://n8n-preview.whenthelightsdie.com
AUTOMATION_N8N_PROXY_ALIAS=automation-staging-n8n
# Chave de criptografia do n8n — propria do staging, NUNCA a de prod. Ex.: openssl rand -hex 24
AUTOMATION_N8N_ENCRYPTION_KEY=TROQUE-chave-aleatoria-longa-EXCLUSIVA-do-staging
AUTOMATION_WAHA_HOST=waha-preview.whenthelightsdie.com
AUTOMATION_WAHA_PROXY_ALIAS=automation-staging-waha
# Auth do dashboard da WAHA — propria do staging.
AUTOMATION_WAHA_DASHBOARD_USER=admin
AUTOMATION_WAHA_DASHBOARD_PASSWORD=TROQUE-senha-forte-EXCLUSIVA-do-staging
# Senha do Redis do bot — propria do staging.
AUTOMATION_REDIS_PASSWORD=TROQUE-senha-forte-EXCLUSIVA-do-staging
# Token de servico do runtime-config (M2) e do Bearer Go->n8n do Omni Chat (M0):
# api e n8n usam o MESMO valor. Proprio do staging.
AUTOMATION_RUNTIME_TOKEN=TROQUE-token-forte-EXCLUSIVO-do-staging
# Omni Chat (M0): base interna do n8n p/ o webhook POST /webhook/omni-chat.
AUTOMATION_N8N_INTERNAL_URL=http://n8n:5678
# Binds locais (127.0.0.1) so para tunel SSH/debug — DISTINTOS das portas de prod
# do profile automation (prod: 15680/13010/16380).
AUTOMATION_N8N_PORT=15681
AUTOMATION_WAHA_PORT=13011
AUTOMATION_REDIS_PORT=16381

# ── Calendario (agenda de conteudo) — IA por n8n ──
# Plano de IA do mes (Fase 6): webhook interno do n8n + token de servico do callback
# (EXCLUSIVO do staging) + base interna da api. Vazios => POST /v1/calendar/ai/plan
# responde 503 ai_not_configured.
CALENDAR_AI_WEBHOOK_URL=http://n8n:5678/webhook/calendar-omni
CALENDAR_AI_SERVICE_TOKEN=TROQUE-token-forte-EXCLUSIVO-do-staging
CALENDAR_AI_CALLBACK_BASE=http://api:8080
# Chat flutuante + voz (C7/C8): webhooks internos do n8n. Vazios => /chat/ask e
# /chat/transcribe respondem 503 acionavel.
CALENDAR_CHAT_WEBHOOK_URL=http://n8n:5678/webhook/calendar-chat
CALENDAR_TRANSCRIBE_WEBHOOK_URL=http://n8n:5678/webhook/calendar-transcribe
