#!/usr/bin/env bash
# Husky pre-commit hook — Omni
#
# Roda lint-staged que despacha:
#   - ESLint + Prettier nos arquivos .vue/.ts/.js/.mjs/.json/.md/.css/.scss do web/
#   - gofmt nos .go do back/
# Depois roda golangci-lint uma unica vez, em escopo de pacote, para evitar que
# os chunks do lint-staged abram varios runners concorrentes.
#
# Para pular em emergencia: git commit --no-verify  (use com parcimonia)
#
# Mantem os formatadores/lints web seriais para limitar consumo em commits grandes.
npx lint-staged --concurrent 1
LINT_STATUS=$?

GO_LINT_STATUS=0
if [ "$LINT_STATUS" -eq 0 ]; then
  GO_FILES=()
  while IFS= read -r -d '' file; do
    GO_FILES+=("$file")
  done < <(git diff --cached --name-only --diff-filter=ACMR -z -- ':(glob)back/**/*.go')

  if [ "${#GO_FILES[@]}" -gt 0 ]; then
    scripts/dev/lint-go-staged.sh "${GO_FILES[@]}"
    GO_LINT_STATUS=$?
  fi
fi

# Guard E0: check GLOBAL e estritamente LOCAL do registro, IDs e hashes canonicos.
# Nao consulta Docker/runtime, nao exporta e nao cria temporario. Drift de runtime so
# pode ser consultado por alias owner-scoped explicito.
N8N_STATUS=0
if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev/n8n-export.ps1 -Check
  N8N_STATUS=$?
fi

if [ "$LINT_STATUS" -ne 0 ]; then
  exit "$LINT_STATUS"
fi
if [ "$GO_LINT_STATUS" -ne 0 ]; then
  exit "$GO_LINT_STATUS"
fi
exit "$N8N_STATUS"
