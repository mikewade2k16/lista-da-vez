#!/usr/bin/env bash
# Husky pre-push hook — Omni
#
# Antes de enviar para o remoto, valida o build de producao do web.
# Isso pega erros que passam por lint/format mas quebram o deploy.
# O bundle atual ultrapassa o heap padrao de ~4 GB do Node no Windows. Mantemos
# o build obrigatorio e ampliamos somente o processo deste hook; o valor pode
# ser ajustado localmente com OMNI_WEB_BUILD_HEAP_MB. NODE_ENV precisa existir
# ANTES de o Nuxt avaliar nuxt.config.ts; sem isso o build nativo reativa os
# sourcemaps de dev, multiplica disco/RAM e repete warnings do Tailwind.

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

WEB_BUILD_HEAP_MB="${OMNI_WEB_BUILD_HEAP_MB:-8192}"
WEB_BUILD_MIN_FREE_MB="${OMNI_WEB_BUILD_MIN_FREE_MB:-3072}"
WEB_BUILD_FREE_MB="$(df -Pm "$ROOT_DIR" | awk 'NR == 2 { print $4 }')"

if [[ ! "$WEB_BUILD_FREE_MB" =~ ^[0-9]+$ ]]; then
  echo "Nao foi possivel medir o espaco livre para validar o build web." >&2
  exit 1
fi

if (( WEB_BUILD_FREE_MB < WEB_BUILD_MIN_FREE_MB )); then
  echo "Espaco insuficiente para o build web: ${WEB_BUILD_FREE_MB} MB livres; minimo ${WEB_BUILD_MIN_FREE_MB} MB." >&2
  echo "Libere espaco no disco ou ajuste OMNI_WEB_BUILD_MIN_FREE_MB conscientemente." >&2
  exit 1
fi

export NODE_ENV=production
export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=${WEB_BUILD_HEAP_MB} --disable-warning=DEP0155"
echo "→ build web de pre-push (heap Node: ${WEB_BUILD_HEAP_MB} MB; disco livre: ${WEB_BUILD_FREE_MB} MB)"
npm run build
