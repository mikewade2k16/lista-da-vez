        "id": "e4f5a6b7-tr00-4000-8000-openaihttp001",
        "name": "Transcrever (OpenAI Whisper)"
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Converte o binario do audio (data0) em base64 e monta o corpo do generateContent do Gemini\n// com inline_data (mime do audio + base64) + um prompt de transcricao. A key vem do payload\n// (body.apiKey), resolvida server-side pelo Go; nunca e logada nem persistida no n8n.\nconst item = $input.first();\nconst body = (item.json && item.json.body) || {};\nconst apiKey = String(body.apiKey || '');\nconst model = String(body.model || '').trim() || 'gemini-2.5-flash';\nconst geminiBase = 'https://generativelanguage.googleapis.com/v1beta';\nconst binaries = item.binary || {};\nconst bkeys = Object.keys(binaries);\nif (!bkeys.length) { throw new Error('Sem audio no request (binary vazio)'); }\nconst bin = binaries[bkeys[0]] || {};\nconst base64 = String(bin.data || '');\nconst mime = String(bin.mimeType || 'audio/webm');\nconst url = geminiBase + '/models/' + model + ':generateContent';\nconst reqBody = { contents: [ { parts: [ { text: 'Transcreva este audio em pt-BR, responda so a transcricao.' }, { inline_data: { mime_type: mime, data: base64 } } ] } ] };\nreturn [{ json: { url: url, apiKey: apiKey, model: model, mime: mime, reqBody: reqBody } }];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          680,
          120
        ],
        "id": "f5a6b7c8-tr00-4000-8000-gembase64001",
        "name": "Montar base64 (Gemini)"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ $json.url }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "x-goog-api-key",
                "value": "={{ $json.apiKey }}"
              },
              {
                "name": "content-type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json.reqBody) }}",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          900,
          120
        ],
        "id": "a6b7c8d9-tr00-4000-8000-geminihttp01",
        "name": "Gemini generateContent",
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Extrai a transcricao do Gemini (candidates[0].content.parts[].text). Erro/vazio -> texto\n// vazio (o back Go so le { text }); nunca loga a key nem o payload cru.\nconst r = ($input.first() && $input.first().json) || {};\nconst cands = Array.isArray(r.candidates) ? r.candidates : [];\nconst parts = (((cands[0] || {}).content) || {}).parts || [];\nlet text = '';\nfor (const p of parts) { if (p && typeof p.text === 'string') text += p.text; }\nreturn [{ json: { text: String(text).trim() } }];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1120,
          120
        ],
        "id": "b7c8d9e0-tr00-4000-8000-gemextrai001",
        "name": "Extrair texto (Gemini)"
      },
