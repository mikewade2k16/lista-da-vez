        "webhookId": "c9d8e7f6-1a2b-4c3d-8e9f-0a1b2c3d4e5f"
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Normaliza o provider (openai OU gemini; qualquer outro cai em gemini) e mantem o binario\n// do audio (data0) para os ramos seguintes. Campos provider/apiKey/model chegam em json.body\n// (form-data do multipart); o arquivo vira o binario data0 (1o arquivo do multipart do webhook).\nconst item = $input.first();\nconst body = (item.json && item.json.body) || {};\nconst raw = String(body.provider || 'gemini').toLowerCase();\nconst provider = raw === 'openai' ? 'openai' : (raw === 'local' ? 'local' : 'gemini');\nreturn [{ json: Object.assign({}, item.json, { provider: provider }), binary: item.binary }];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          220,
          0
        ],
        "id": "c2d3e4f5-tr00-4000-8000-preparar00001",
        "name": "Preparar"
      },
      {
        "parameters": {
          "rules": {
            "values": [
              {
                "conditions": {
                  "options": {
                    "caseSensitive": true,
                    "leftValue": "",
                    "typeValidation": "loose",
                    "version": 2
                  },
                  "conditions": [
                    {
                      "id": "cond-openai-0001",
                      "leftValue": "={{ $json.provider }}",
                      "rightValue": "openai",
                      "operator": {
