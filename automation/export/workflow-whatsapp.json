      {
        "parameters": {
          "jsCode": "const data = $getWorkflowStaticData('global');\nif (!data.seen) data.seen = [];\nconst id = $input.first().json.playload_id || '';\nif (id && data.seen.indexOf(id) !== -1) return [];\nif (id) { data.seen.push(id); if (data.seen.length > 300) data.seen = data.seen.slice(-300); }\n// Boot cutoff: rejeita mensagens com mais de 5 minutos de idade.\nconst msgTs = $input.first().json.msgTimestamp || 0;\nif (msgTs && (Date.now() - msgTs) > 5 * 60 * 1000) return [];\nreturn $input.all();"
        },
