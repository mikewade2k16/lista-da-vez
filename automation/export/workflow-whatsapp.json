      {
        "parameters": {
          "jsCode": "const cfg=$('Get runtime config').first().json;const msg=($input.first().json.message||'').toLowerCase();const docs=cfg.docs||[];const persona=cfg.persona||'';const guardrails=cfg.guardrails||'';const kmap=[{title:'Empresa e Contatos',kw:['empresa','crow','contato','equipe','telefone','quem']},{title:'Produtos e Servicos',kw:['produto','servico','video','foto','reels','conteudo','pacote']},{title:'Publico-Alvo',kw:['publico','cliente','nicho','audiencia','perfil']},{title:'Regras',kw:['prazo','entrega','cancelamento','revisao','regra']},{title:'Tom de Voz e FAQ',kw:['como','por que','quando','duvida','faq','pergunta','postura']},{title:'Comercial',kw:['preco','valor','orcamento','investimento','custo','contrato','proposta','tabela','quanto','pagamento']}];const matched=[];const others=[];for(const doc of docs){if(!doc.enabled)continue;const entry=kmap.find(e=>doc.title&&doc.title.toLowerCase().includes(e.title.toLowerCase().split(' ')[0]));const kws=entry?entry.kw:[];if(kws.some(k=>msg.includes(k)))matched.push(doc);else others.push(doc);}const sel=matched.length>0?matched:others;let sm=persona;for(const doc of sel){sm+='\\n\\n---\\n\\n';if(doc.title)sm+='## '+doc.title+'\\n\\n';sm+=doc.body||'';}sm+='\\n\\n'+guardrails;return [{json:{...$input.first().json,systemMessage:sm}}];"
        },
