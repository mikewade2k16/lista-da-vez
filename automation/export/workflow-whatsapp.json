      {
        "parameters": {
          "jsCode": "const prev = $('Ctx: ler').first().json;\nconst chatId = prev.chatId;\nconst msg = prev.message;\nconst decision = String($input.first().json.text || '').toUpperCase();\nconst isNew = decision.indexOf('NOVO') !== -1 || (prev.gapMin || 0) > 360;\nlet seg = prev.seg || 0;\nif (isNew) seg = seg + 1;\nreturn [{ json: { message: msg, seg: seg, chatId: chatId, ctxDecision: isNew ? 'NOVO' : 'CONTINUA', longMem: prev.longMem || '' } }];"
        },
        "id": "32a7609a-5c77-4946-a21b-3dfedf0b7ea0",
        "name": "Ctx: aplicar",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
