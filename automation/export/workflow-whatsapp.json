      {
        "parameters": {
          "jsCode": "const out = String($('AI Agent').first().json.output || '').trim();\nconst NL = String.fromCharCode(10);\nlet parts;\nif (out.indexOf('|||') !== -1) { parts = out.split('|||'); }\nelse { parts = out.split(NL + NL); }\nparts = parts.map(function(s){ return s.trim(); }).filter(function(s){ return s.length; });\nif (parts.length === 0) parts = [out];\nif (parts.length > 5) { parts = parts.slice(0,4).concat([parts.slice(4).join(NL + NL)]); }\nreturn parts.map(function(p){ return { json: { text: p } }; });"
        },
