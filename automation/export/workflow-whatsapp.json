      {
        "parameters": {
          "jsCode": "const buf = $('Fila buffer').first().json.bufList;\nconst list = Array.isArray(buf) ? buf : (buf ? [buf] : []);\nlet message = list.join(' ').trim();\nif (!message) message = String($('Dados').first().json.message || '');\nconst dados = $('Dados').first().json;\nconst ctxParts = [];\nif (dados.isSticker) ctxParts.push('[contexto: figurinha]');\nif (dados.isForwarded) ctxParts.push('[contexto: mensagem encaminhada]');\nif (dados.isReply && dados.quotedText) ctxParts.push('[contexto: respondendo a \"' + dados.quotedText + '\"]');\nelse if (dados.isReply) ctxParts.push('[contexto: mensagem de resposta]');\nconst ctxPrefix = ctxParts.length ? ctxParts.join(' ') + '\\n' : '';\nmessage = ctxPrefix + message;\nreturn [{ json: { message: message } }];"
        },
