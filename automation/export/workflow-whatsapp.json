          "jsCode": "// Gate do liga/desliga (M2): para o fluxo se a automacao estiver desligada.\nconst cfg = $('Get runtime config').first().json;\nif (cfg && cfg.enabled === false) return [];\nreturn $('Ctx: aplicar').all();"
