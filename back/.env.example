APP_NAME=omni-api
APP_ENV=development
APP_ADDR=:8080
WEB_APP_URL=http://localhost:3003

# Cloudflare R2 privado para o fallback sem Docker. Copie para back/.env somente
# quando executar a API diretamente; no Docker local, use o .env da raiz.
# Ative somente com bucket Standard dedicado e vazio.
# Limites operacionais sao editados no painel e persistidos em storage.settings.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REQUEST_TIMEOUT=30s
R2_UPLOAD_TIMEOUT=15m
# Bearer token separado: Account Analytics Read + Workers R2 Storage Read.
R2_ANALYTICS_API_TOKEN=
# Excecao de bootstrap: permite registrar um bucket dedicado ja populado. Default seguro: false.
R2_ALLOW_NONEMPTY_BUCKET_INITIALIZATION=false

ATTENDANCE_AUDIO_DIR=data/media/attendance-audio
ATTENDANCE_TRANSCRIPTION_BASE_URL=http://localhost:8010
ATTENDANCE_TRANSCRIPTION_MODEL=Systran/faster-whisper-base
ATTENDANCE_TRANSCRIPTION_LANGUAGE=pt
ATTENDANCE_TRANSCRIPTION_TIMEOUT=10m
ATTENDANCE_ANALYSIS_WEBHOOK_URL=
ATTENDANCE_ANALYSIS_TIMEOUT=20m

DATABASE_URL=postgres://omni:omni_dev@localhost:5432/omni?sslmode=disable
# AC-04: URL de RUNTIME da api (role least-privilege omni_app). Dev local fora do
# docker funciona sem ela: OpenAppPool cai no fallback DATABASE_URL. Descomente
# para exercitar a role least-privilege localmente (crie a role via scripts/db/create-app-role.sql).
# DATABASE_APP_URL=postgres://omni_app:omni_app_dev@localhost:5432/omni?sslmode=disable
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONNS=10
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

AUTH_TOKEN_SECRET=troque-por-um-segredo-longo-e-aleatorio
AUTH_TOKEN_TTL=12h
AUTH_INVITE_TTL=168h
AUTH_PASSWORD_RESET_TTL=30m
# Cache de Principal autenticado (AC-01). 0s desliga. Default 30s.
# AUTH_PRINCIPAL_CACHE_TTL=30s
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Omni
SMTP_TLS_MODE=starttls
SMTP_INSECURE_SKIP_VERIFY=false
SMTP_TIMEOUT=10s
AUTH_BCRYPT_COST=10
AUTH_CONSULTANT_EMAIL_DOMAIN=acesso.omni.local
AUTH_CONSULTANT_DEFAULT_PASSWORD=troque-esta-senha-local
ERP_CSV_MAX_BYTES=134217728
ERP_MANUAL_SYNC_MAX_FILES=100
ERP_BACKFILL_MAX_FILES=1000
ERP_MANUAL_SYNC_MIN_INTERVAL=5m

PEROLA_BI_COMPANY_KEY=
PEROLA_BI_LOGIN=
PEROLA_BI_PASS=
PEROLA_BI_TOKEN=
PEROLA_BI_CNPJ_EMPRESA=
PEROLA_BI_TOKEN_TTL=50m
PEROLA_BI_REQUEST_TIMEOUT=12s
PEROLA_BI_PAGE_LIMIT=100
PEROLA_BI_MAX_PAGES=50

# Reestruturacao multi-tenant (branch refactor/multi-tenant-core).
# Quando true, ativa endpoints v2 e schema core novo. Manter false em prod
# ate a Fase 4 atingir paridade com o produto atual.
CORE_V2_ENABLED=false

# Customer Data: chaves independentes, base64 de exatamente 32 bytes.
# Gere cada uma separadamente e nunca reutilize/troque sem recriptografia.
CUSTOMER_DATA_ENCRYPTION_KEY=
CUSTOMER_DATA_HMAC_KEY=

# ── Calendario (agenda de conteudo) — IA por n8n ──
# Plano de IA do mes (Fase 6): webhook do n8n que gera o plano + token de servico do
# callback + base publica da api p/ o n8n chamar de volta. Vazios => POST
# /v1/calendar/ai/plan responde 503 ai_not_configured. As CHAVES de API dos
# provedores vivem nas credentials do n8n, NAO aqui.
CALENDAR_AI_WEBHOOK_URL=
CALENDAR_AI_SERVICE_TOKEN=
CALENDAR_AI_CALLBACK_BASE=
# Chat flutuante + voz (C7/C8): webhooks do n8n (proxy fino Go->n8n). Vazios =>
# /v1/calendar/chat/ask responde 503 chat_not_configured e /chat/transcribe responde
# 503 transcribe_not_configured. Ex.: http://localhost:5680/webhook/calendar-chat.
CALENDAR_CHAT_WEBHOOK_URL=
CALENDAR_TRANSCRIBE_WEBHOOK_URL=
