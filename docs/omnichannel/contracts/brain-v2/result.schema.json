{
  "$id": "https://omni.local/contracts/brain-v2/result.schema.json",
  "title": "Omnichannel brain result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dispatchId",
    "generation",
    "decision",
    "reply",
    "classification",
    "extractedFields",
    "suggestedRouting",
    "handoff",
    "usage",
    "trace"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["brain.result.v2"]
    },
    "dispatchId": {"type": "string", "minLength": 1, "maxLength": 64},
    "generation": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "decision": {
      "type": "string",
      "enum": ["continue_ai", "handoff", "no_reply"]
    },
    "reply": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["text", "inReplyToMessageId"],
      "properties": {
        "text": {"type": ["string", "null"], "maxLength": 4000},
        "inReplyToMessageId": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "confidence", "sentiment"],
      "properties": {
        "intent": {"type": "string", "minLength": 1, "maxLength": 120},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sentiment": {"type": "string", "enum": ["positive", "neutral", "negative", "unknown"]}
      }
    },
    "extractedFields": {"type": "object", "additionalProperties": true, "maxProperties": 100},
    "suggestedRouting": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["departmentSlug", "queueSlug"],
      "properties": {
        "departmentSlug": {"type": ["string", "null"], "maxLength": 120},
        "queueSlug": {"type": ["string", "null"], "maxLength": 120}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needed", "reasonCode", "summary"],
      "properties": {
        "needed": {"type": "boolean"},
        "reasonCode": {"type": ["string", "null"], "maxLength": 120},
        "summary": {"type": ["string", "null"], "maxLength": 4000}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "promptTokens", "completionTokens", "cost"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 120},
        "model": {"type": "string", "minLength": 1, "maxLength": 160},
        "promptTokens": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "completionTokens": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "cost": {"type": "number", "minimum": 0, "maximum": 1000000}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCalls", "warnings"],
      "properties": {
        "toolCalls": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 120},
              "status": {"type": "string", "enum": ["ok", "error", "denied", "timeout"]}
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 50,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
