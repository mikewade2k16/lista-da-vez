{
  "$id": "https://omni.local/contracts/media-analysis/document.schema.json",
  "title": "Omnichannel document analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "extractedText", "pageCount", "truncated", "warnings"],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 20000
    },
    "extractedText": {
      "type": "string",
      "maxLength": 50000
    },
    "pageCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "truncated": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  }
}
