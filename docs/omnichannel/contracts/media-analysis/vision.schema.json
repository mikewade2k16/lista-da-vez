{
  "$id": "https://omni.local/contracts/media-analysis/vision.schema.json",
  "title": "Omnichannel vision analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "visibleText", "objects", "safetyFlags"],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 20000
    },
    "visibleText": {
      "type": "string",
      "maxLength": 20000
    },
    "objects": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "safetyFlags": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
