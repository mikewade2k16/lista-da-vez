# Copie para observability/.env.local (ignorado pelo Git) e preencha.
# O runner so faz login; nunca altera senha nem dados de usuario.
OBS_USER_ADMIN_EMAIL=
OBS_USER_ADMIN_PASSWORD=
# Opcional: perfil sem permissao de admin, para o teste de autorizacao entre perfis.
OBS_USER_CONSULTANT_EMAIL=
OBS_USER_CONSULTANT_PASSWORD=
# Opcional: duas contas de tenants diferentes para o teste de isolamento (fase security).
# Use contas de teste somente leitura; o runner so faz login e GET.
OBS_USER_TENANT_A_EMAIL=
OBS_USER_TENANT_A_PASSWORD=
OBS_USER_TENANT_B_EMAIL=
OBS_USER_TENANT_B_PASSWORD=
