{
  "name": "omni",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "docker compose up --build --watch",
    "dev:detach": "docker compose up -d",
    "dev:watch": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\watch-web.ps1",
    "dev:build": "docker compose build",
    "dev:down": "docker compose down",
    "dev:down:volumes": "docker compose down -v",
    "dev:logs": "docker compose logs -f",
    "dev:ps": "docker compose ps",
    "dev:rebuild": "docker compose build --no-cache",
    "n8n:import:chat": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-import.ps1 -Owner calendar -Only calendar-chat",
    "n8n:import:calendar-omni": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-import.ps1 -Owner calendar -Only calendar-omni",
    "n8n:import:calendar-transcribe": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-import.ps1 -Owner calendar -Only calendar-transcribe",
    "n8n:import:omni-chat": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-import.ps1 -Owner operation -Only omni-chat",
    "n8n:import:whatsapp": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-import.ps1 -Owner automation -Only whatsapp",
    "n8n:import:omnichannel-brain": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-import.ps1 -Owner omnichannel -Only omnichannel-brain",
    "n8n:import:instagram-first-contact": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-import.ps1 -Owner omnichannel -Only instagram-first-contact",
    "n8n:export:chat": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Owner calendar -Only calendar-chat",
    "n8n:export:calendar-omni": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Owner calendar -Only calendar-omni",
    "n8n:export:calendar-transcribe": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Owner calendar -Only calendar-transcribe",
    "n8n:export:omni-chat": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Owner operation -Only omni-chat",
    "n8n:export:whatsapp": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Owner automation -Only whatsapp",
    "n8n:export:omnichannel-brain": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Owner omnichannel -Only omnichannel-brain",
    "n8n:export:omnichannel-brain:check": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Check -Owner omnichannel -Only omnichannel-brain",
    "n8n:export:omnichannel-brain:sync": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Sync -Owner omnichannel -Only omnichannel-brain",
    "n8n:export:instagram-first-contact": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Owner omnichannel -Only instagram-first-contact",
    "n8n:export:instagram-first-contact:check": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Check -Owner omnichannel -Only instagram-first-contact",
    "n8n:export:instagram-first-contact:sync": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Sync -Owner omnichannel -Only instagram-first-contact",
    "n8n:export:check": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-export.ps1 -Check",
    "n8n:test:ownership": "powershell.exe -ExecutionPolicy Bypass -File scripts\\dev\\n8n-workflow-guards.tests.ps1",
    "prod:config": "docker compose --env-file .env.production -f docker-compose.prod.yml config",
    "prod:build": "docker compose --env-file .env.production -f docker-compose.prod.yml build",
    "prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build",
    "prod:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f",
    "prod:ps": "docker compose --env-file .env.production -f docker-compose.prod.yml ps",
    "prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "deploy:fast": "powershell.exe -ExecutionPolicy Bypass -File scripts\\deploy\\deploy-fast.ps1 -Environment staging",
    "deploy:fast:prod": "powershell.exe -ExecutionPolicy Bypass -File scripts\\deploy\\deploy-fast.ps1 -Environment prod -BackupDatabase",
    "deploy:staging": "powershell.exe -ExecutionPolicy Bypass -File scripts\\deploy\\staging-up.ps1",
    "deploy:staging:down": "powershell.exe -ExecutionPolicy Bypass -File scripts\\deploy\\staging-down.ps1",
    "deploy:prod": "powershell.exe -ExecutionPolicy Bypass -File scripts\\deploy\\deploy-pull.ps1 -Environment prod -BackupDatabase",
    "deploy:promote": "powershell.exe -ExecutionPolicy Bypass -File scripts\\deploy\\promote.ps1",
    "dev:web": "npm --prefix web run dev",
    "dev:web:3003": "npm --prefix web run dev:3003",
    "dev:web:3001": "npm --prefix web run dev:3001",
    "dev:local": "scripts\\dev\\git-bash.cmd ./scripts/dev/up-local.sh",
    "dev:local:3003": "scripts\\dev\\git-bash.cmd ./scripts/dev/up-local.sh",
    "dev:local:3001": "scripts\\dev\\git-bash.cmd ./scripts/dev/up-local.sh",
    "dev:local:db": "scripts\\dev\\git-bash.cmd ./scripts/dev/start-postgres-local.sh",
    "dev:local:api": "scripts\\dev\\git-bash.cmd ./scripts/dev/start-api-local.sh",
    "dev:local:api:status": "scripts\\dev\\git-bash.cmd ./scripts/dev/status-api-local.sh",
    "dev:local:api:stop": "scripts\\dev\\git-bash.cmd ./scripts/dev/stop-api-local.sh",
    "build": "npm --prefix web run build",
    "generate": "npm --prefix web run generate",
    "inventory": "node scripts/dev/gen-component-inventory.mjs",
    "preview": "npm --prefix web run preview",
    "lint:web": "npm --prefix web run lint",
    "lint:back": "bash -c 'cd back && golangci-lint run ./...'",
    "lint": "npm run lint:web && npm run lint:back"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "_lint-staged-note": "Config completa fica em lint-staged.config.mjs — precisamos transformar caminhos para ESLint/Prettier rodarem com cwd em web/"
}
